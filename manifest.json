{
  "manifest_version": 3,
  "name": "iPadOS New Tab",
  "version": "1.0",
  "description": "A new tab page that replicates the iPadOS interface.",
  "permissions": [
    "storage",
    "favicon"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": "icons/icon16.png"
  }
}
